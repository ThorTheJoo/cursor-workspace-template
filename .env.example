# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files with real values.
# See: docs/_ai_context/knowledge/governance/SECURITY_CONTROLS.md
# ============================================================

# -- Database --
# DATABASE_URL=                  # Connection string (e.g., postgresql://user:pass@host:5432/db)

# -- Authentication --
# JWT_SECRET=                    # Generate: openssl rand -base64 32
# NEXTAUTH_SECRET=               # Generate: openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000

# -- External APIs --
# Add API keys here with descriptions but NO values.
# Format: VAR_NAME=              # Description + where to get it

# -- Non-sensitive defaults (safe to set here) --
NODE_ENV=development
PORT=3000
