{
  "name": "Cursor Workspace Starter",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  // Network isolation: uncomment the next line to disable all network access.
  // For a fully pre-configured air-gapped variant, use devcontainer.no-net.json instead.
  // "runArgs": ["--network=none"],

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "apt-get update && apt-get install -y jq fzf curl && chmod +x setup-tools.sh && echo '\\n[OK] Prerequisites installed. Run ./setup-tools.sh to select and install your tools.\\n'",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.preferences.importModuleSpecifier": "non-relative"
      }
    }
  },
  "remoteUser": "vscode"
}
