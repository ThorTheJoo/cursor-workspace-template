# sample.envrc -- direnv template for Cursor Workspace Starter
#
# Copy to .envrc and run `direnv allow` to activate.
# NEVER commit .envrc with real secrets — only this sample file is tracked.
#
# See: https://direnv.net/

# Load .env.local if present (gitignored, for local overrides)
dotenv_if_exists .env.local

# Secret manager integration (uncomment one):
#
# 1Password CLI:
#   export API_KEY=$(op read "op://Vault/Item/Field")
#
# Doppler:
#   eval $(doppler secrets download --no-file --format=env)
#
# AWS Secrets Manager:
#   export DB_PASSWORD=$(aws secretsmanager get-secret-value --secret-id my-secret --query SecretString --output text)

# Project defaults (safe to commit)
export NODE_ENV=development
export MDD_ROOT=docs/_ai_context
