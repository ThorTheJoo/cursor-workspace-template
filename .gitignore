# ── Tool cache (cloned repos — never commit) ───────────────────────
.tools-cache/

# ── Generated security artifacts (regenerated by bootstrapper) ─────
SECURITY-LOCK.json

# ── Node ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Build outputs ───────────────────────────────────────────────────
dist/
.next/
out/
build/
*.tsbuildinfo

# ── Environment variables & secrets ─────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.envrc

# ── Private keys & certificates ────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cert
*.crt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.gpg

# ── Credential files ──────────────────────────────────────────────
credentials.json
serviceAccountKey.json
service-account*.json
gcloud-service-key.json
*-credentials.json
*.credential
.htpasswd
.netrc
.npmrc
.pypirc
.docker/config.json

# ── Cloud provider configs with secrets ────────────────────────────
.aws/credentials
.azure/accessTokens.json
kubeconfig
terraform.tfstate
terraform.tfstate.backup
*.tfvars

# ── OS artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE (non-Cursor) ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Python (for autoresearch and similar tools) ─────────────────────
__pycache__/
*.pyc
.venv/
.Python

# ── Cursor caches (keep rules, bin, skills, mcp committed) ─────────
.cursor/automations/
.cursor/.cache/

# ── Coverage and test artifacts ─────────────────────────────────────
coverage/
.nyc_output/
