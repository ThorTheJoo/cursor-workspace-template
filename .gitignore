# ── Tool cache (cloned repos — never commit) ───────────────────────
.tools-cache/

# ── Node ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Build outputs ───────────────────────────────────────────────────
dist/
.next/
out/
build/
*.tsbuildinfo

# ── Environment variables ───────────────────────────────────────────
.env
.env.local
.env.*.local

# ── OS artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE (non-Cursor) ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Python (for autoresearch and similar tools) ─────────────────────
__pycache__/
*.pyc
.venv/
.Python

# ── Cursor caches (keep rules, bin, skills, mcp committed) ─────────
.cursor/automations/
.cursor/.cache/

# ── Coverage and test artifacts ─────────────────────────────────────
coverage/
.nyc_output/
